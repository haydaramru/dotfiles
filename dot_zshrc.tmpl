# =============================================================================
# ~/.zshrc — managed by chezmoi
# Machine: {{ .chezmoi.hostname }} ({{ .chezmoi.os }}/{{ .chezmoi.arch }})
# =============================================================================

# ---------------------------------------------------------------------------
# Powerlevel10k instant prompt (must stay near top)
# ---------------------------------------------------------------------------
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# ---------------------------------------------------------------------------
# XDG base dirs (ensure consistency)
# ---------------------------------------------------------------------------
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"

# ---------------------------------------------------------------------------
# PATH helpers — deduplicate
# ---------------------------------------------------------------------------
typeset -U path  # zsh built-in: keeps PATH entries unique

# ---------------------------------------------------------------------------
# Homebrew (macOS only)
# ---------------------------------------------------------------------------
{{- if eq .chezmoi.os "darwin" }}
eval "$(/opt/homebrew/bin/brew shellenv 2>/dev/null || /usr/local/bin/brew shellenv 2>/dev/null)"
{{- end }}

# ---------------------------------------------------------------------------
# Zsh plugins (git-cloned to ~/.local/share/zsh/plugins)
# ---------------------------------------------------------------------------
ZSH_PLUGINS="$XDG_DATA_HOME/zsh/plugins"

# Powerlevel10k
if [[ -d "$ZSH_PLUGINS/powerlevel10k" ]]; then
  source "$ZSH_PLUGINS/powerlevel10k/powerlevel10k.zsh-theme"
fi

# zsh-syntax-highlighting
if [[ -d "$ZSH_PLUGINS/zsh-syntax-highlighting" ]]; then
  source "$ZSH_PLUGINS/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
fi

# zsh-autosuggestions
if [[ -d "$ZSH_PLUGINS/zsh-autosuggestions" ]]; then
  source "$ZSH_PLUGINS/zsh-autosuggestions/zsh-autosuggestions.zsh"
fi

# ---------------------------------------------------------------------------
# p10k config
# ---------------------------------------------------------------------------
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

# ---------------------------------------------------------------------------
# Language runtimes & tools (conditional per machine)
# ---------------------------------------------------------------------------

# Bun
if [[ -d "$HOME/.bun" ]]; then
  export BUN_INSTALL="$HOME/.bun"
  path=("$BUN_INSTALL/bin" $path)
fi

{{- if eq .chezmoi.os "darwin" }}

# Go (Homebrew)
if [[ -d "/opt/homebrew/opt/go@1.22/bin" ]]; then
  path=("/opt/homebrew/opt/go@1.22/bin" $path)
fi

# TeX Live
if [[ -d "/usr/local/texlive/2025/bin/universal-darwin" ]]; then
  path=("/usr/local/texlive/2025/bin/universal-darwin" $path)
fi

# Java 17
if [[ -d "/Library/Java/JavaVirtualMachines/openjdk-17.jdk/Contents/Home" ]]; then
  export JAVA_HOME="/Library/Java/JavaVirtualMachines/openjdk-17.jdk/Contents/Home"
fi

# Flutter
if [[ -d "$HOME/Developer/flutter/bin" ]]; then
  path=("$HOME/Developer/flutter/bin" $path)
fi

# Android SDK
if [[ -d "$HOME/Library/Android/sdk" ]]; then
  export ANDROID_HOME="$HOME/Library/Android/sdk"
  path=("$ANDROID_HOME/emulator" "$ANDROID_HOME/platform-tools" $path)
fi

# Google Cloud SDK
if [[ -f "$HOME/Downloads/google-cloud-sdk/path.zsh.inc" ]]; then
  source "$HOME/Downloads/google-cloud-sdk/path.zsh.inc"
fi
if [[ -f "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc" ]]; then
  source "$HOME/Downloads/google-cloud-sdk/completion.zsh.inc"
fi

# Antigravity
if [[ -d "$HOME/.antigravity/antigravity/bin" ]]; then
  path=("$HOME/.antigravity/antigravity/bin" $path)
fi
{{- end }}

{{- if eq .chezmoi.os "linux" }}

# Linux-specific tools
# Go (snap/manual install)
if [[ -d "/usr/local/go/bin" ]]; then
  path=("/usr/local/go/bin" $path)
fi

# Java (default)
if [[ -d "/usr/lib/jvm/java-17-openjdk-$(dpkg --print-architecture 2>/dev/null)" ]]; then
  export JAVA_HOME="/usr/lib/jvm/java-17-openjdk-$(dpkg --print-architecture)"
fi
{{- end }}

# ---------------------------------------------------------------------------
# Local bin (all platforms)
# ---------------------------------------------------------------------------
path=("$HOME/.local/bin" $path)
[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"

# ---------------------------------------------------------------------------
# Aliases & functions (shared)
# ---------------------------------------------------------------------------
alias ll='ls -lah'
alias gz='chezmoi'
alias gza='chezmoi apply'
alias gzd='chezmoi diff'
alias gze='chezmoi edit'

# ---------------------------------------------------------------------------
# Local overrides (not managed by chezmoi)
# ---------------------------------------------------------------------------
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local
